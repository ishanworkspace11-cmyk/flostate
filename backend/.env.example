# ==============================================================================
# The Dormammu Loop - Backend Environment Configuration
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://dormammu:dormammu_secret@localhost:5432/dormammu_db?schema=public"

# Redis Cache & BullMQ Queue (Redis 7)
REDIS_URL="redis://localhost:6379"

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Structured Logging (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Distributed Worker Settings
WORKER_ID=""
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_STALE_THRESHOLD_MS=15000
WORKER_OFFLINE_THRESHOLD_MS=45000
AUTO_START_DEFAULT_WORKER=true

# Operational Worker Internal Shared Secret
INTERNAL_WORKER_SECRET="dormammu-internal-secret-worker-auth"

# Demo & Disaster Recovery Safety
# Set to 'true' only in development or staging to permit POST /api/v1/settings/reset-demo
ALLOW_DEMO_RESET=true
